[Unit]
Description=BlocksScreen worktree integrity check
After=local-fs.target
Before=BlocksScreen-xorg.service BlocksScreen.service BlocksScreen-updater.service
Before=BlocksScreen-deploy.service BlocksScreen-bootstrap.service BlocksScreen-clock.service
# Delays Moonraker up to 60 s only when HEAD is unreadable and the guard fetches.
Before=moonraker.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=120
ExecStart=/bin/bash /usr/local/lib/blocksscreen/bs-tree-guard.sh BS_DIR BS_PRIMARY_HOME
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
