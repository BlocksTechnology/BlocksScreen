[Unit]
Description=BlocksScreen Updater D-Bus Daemon
# network-online.target, not network.target: the boot poll needs DNS, not just an interface.
After=dbus.service network.target network-online.target
Wants=network-online.target
Requires=dbus.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=blocks
Group=blocksscreen
WorkingDirectory=BS_DIR
Environment=HOME=BS_PRIMARY_HOME
ExecStart=BSENV/bin/python3.11 -m updater daemon
Restart=always
RestartSec=5
WatchdogSec=30s

[Install]
WantedBy=multi-user.target
