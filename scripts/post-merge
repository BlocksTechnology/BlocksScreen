#!/bin/bash
set -euo pipefail

SCRIPT_PATH=$(dirname -- "$(readlink -f -- "$0")")
BS_PATH=$(dirname "$SCRIPT_PATH")
_BSENV_USER="${SUDO_USER:-$USER}"
_BSENV_HOME=$(getent passwd "$_BSENV_USER" | cut -d: -f6)
BSENV="${BLOCKSSCREEN_VENV:-${_BSENV_HOME}/.BlocksScreen-env}"

# ── Moonraker config migration (idempotent) ──────────────────────────────────
# Disable Moonraker's PackageKit system upgrade (was causing full apt upgrade
# on every Update click). Fix BlocksScreen managed_services (was restarting
# klipper/moonraker instead of BlocksScreen).
_MOONRAKER_CONF="$_BSENV_HOME/printer_data/config/moonraker.conf"
if [ -f "$_MOONRAKER_CONF" ]; then
    cp "$_MOONRAKER_CONF" "${_MOONRAKER_CONF}.bak" 2>/dev/null || true
    _mr_patched=false
    if ! grep -q "enable_system_updates" "$_MOONRAKER_CONF"; then
        sed -i '/^\[update_manager\]$/a enable_system_updates: False' "$_MOONRAKER_CONF"
        _mr_patched=true
        echo "[post-merge] moonraker.conf: disabled system apt upgrades"
    fi
    if grep -q "managed_services: klipper moonraker" "$_MOONRAKER_CONF"; then
        sed -i '/^\[update_manager BlocksScreen\]/,/^\[/ s/managed_services: klipper moonraker/managed_services: BlocksScreen/' "$_MOONRAKER_CONF"
        _mr_patched=true
        echo "[post-merge] moonraker.conf: fixed BlocksScreen managed_services"
    fi
    if $_mr_patched; then
        sudo systemctl restart moonraker.service 2>/dev/null || true
    fi
fi
# ─────────────────────────────────────────────────────────────────────────────

changed=$(git -C "$BS_PATH" diff ORIG_HEAD HEAD --name-only 2>/dev/null || true)

# ── Pre-flight: run all heavy prep before any restart ────────────────────────
# Everything here is idempotent — safe to re-run on every merge.

# 1. Pre-install pip requirements so the next service start is instant.
REQS_HASH=$(md5sum "$BS_PATH/scripts/requirements.txt" | cut -d' ' -f1)
SENTINEL="$BSENV/.blockscreen-reqs-hash"
if [ ! -f "$SENTINEL" ] || [ "$(cat "$SENTINEL")" != "$REQS_HASH" ]; then
    echo "[post-merge] requirements changed — pre-installing deps (this may take a few minutes) ..."
    if "$BSENV/bin/pip" install --quiet \
        --only-binary :all: \
        --no-binary sdbus,sdbus-networkmanager \
        --upgrade-strategy=only-if-needed \
        -r "$BS_PATH/scripts/requirements.txt"; then
        echo "$REQS_HASH" >"$SENTINEL"
        echo "[post-merge] deps installed"
    fi
fi

# 2. Sync all service files so start.sh finds them already in place.
_need_reload=false
_svc_sync() {
    local src="$1" dst="$2"
    [ -f "$src" ] || return 0
    if ! diff -q "$dst" "$src" >/dev/null 2>&1; then
        sudo cp "$src" "$dst" && echo "[post-merge] updated $(basename "$dst")" || true
        _need_reload=true
    fi
}
[[ ! -L /etc/systemd/system/BlocksScreen.service ]] &&
    _svc_sync "$SCRIPT_PATH/BlocksScreen.service" /etc/systemd/system/BlocksScreen.service
_svc_sync "$SCRIPT_PATH/BlocksScreen-xorg.service" /etc/systemd/system/BlocksScreen-xorg.service
_svc_sync "$SCRIPT_PATH/BlocksScreen-splash-holder.service" /etc/systemd/system/BlocksScreen-splash-holder.service
if $_need_reload; then
    dbus-send --system --print-reply \
        --dest=org.freedesktop.systemd1 \
        /org/freedesktop/systemd1 \
        org.freedesktop.systemd1.Manager.Reload 2>/dev/null ||
        sudo systemctl daemon-reload || true
    if [ -f /etc/systemd/system/BlocksScreen-xorg.service ]; then
        sudo systemctl enable BlocksScreen-xorg.service 2>/dev/null || true
        systemctl is-active --quiet BlocksScreen-xorg.service ||
            sudo systemctl start --no-block BlocksScreen-xorg.service 2>/dev/null || true
    fi
fi

# 3. Install updater service on first deploy or if missing.
if [ ! -f /etc/systemd/system/BlocksScreen-updater.service ]; then
    echo "[post-merge] installing updater ..."
    sudo bash "$SCRIPT_PATH/install-updater.sh"
fi

# 4. Precompute splash cache so the first Qt restart shows the right logo.
"$BSENV/bin/python3.11" "$SCRIPT_PATH/bs-splash.py" --precompute 2>/dev/null || true

# ─────────────────────────────────────────────────────────────────────────────

# ── Service restart based on what changed ────────────────────────────────────
if echo "$changed" | grep -qE '^scripts/BlocksScreen-updater\.service$|^scripts/BlocksScreen-bootstrap\.service$|^scripts/com\.blockscreen\.Updater\.conf$|^scripts/install-updater\.sh$'; then
    echo "[post-merge] Updater install files changed - reinstalling updater ..."
    sudo bash "$SCRIPT_PATH/install-updater.sh"
elif echo "$changed" | grep -qE '^scripts/bs-splash-holder\.py$'; then
    echo "[post-merge] Splash-holder script changed - restarting ..."
    sudo systemctl restart --no-block BlocksScreen-splash-holder.service || true
elif echo "$changed" | grep -qE '^updater/'; then
    echo "[post-merge] Updater code changed - restarting daemon ..."
    sudo systemctl restart BlocksScreen-updater.service
fi
