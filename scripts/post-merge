#!/bin/bash
set -euo pipefail

SCRIPT_PATH=$(dirname -- "$(readlink -f -- "$0")")
BS_PATH=$(dirname "$SCRIPT_PATH")
# Hardcode 'blocks' like the other scripts: $USER=root under a root pull would derive /root and skip every patch.
_BSENV_USER="blocks"
_BSENV_HOME=$(getent passwd "$_BSENV_USER" | cut -d: -f6)
BSENV="${BLOCKSSCREEN_VENV:-${_BSENV_HOME}/.BlocksScreen-env}"
# Skip pip's PyPI self-check: it stalls every install on an offline box and only prints a notice.
export PIP_DISABLE_PIP_VERSION_CHECK=1

# A root pull must not leave root-owned dists in the blocks venv (breaks later pip runs).
_as_blocks() { if [ "$(id -u)" = "0" ]; then runuser -u "$_BSENV_USER" -- "$@"; else "$@"; fi; }
_own() { [ "$(id -u)" = "0" ] && chown "$_BSENV_USER" "$1" 2>/dev/null || true; }

# shellcheck source=/dev/null
if [ -f "$SCRIPT_PATH/bs-common.sh" ]; then . "$SCRIPT_PATH/bs-common.sh"; fi

bs_migrate_moonraker_conf "$_BSENV_HOME/printer_data/config/moonraker.conf" post-merge

changed=$(git -C "$BS_PATH" diff ORIG_HEAD HEAD --name-only 2>/dev/null || true)

# Pre-flight: heavy prep before any restart; everything here is idempotent.

# 1. Pre-install pip requirements so the next service start is instant.
REQS="$BS_PATH/scripts/requirements.txt"
REQS_HASH=$(md5sum "$REQS" | cut -d' ' -f1)
SENTINEL="$BSENV/.blockscreen-reqs-hash"
ATTEMPT="$BSENV/.blockscreen-reqs-attempt"
REINSTALL=""
# A truncated package (interrupted pip, power cut) still imports and yields only its dunders.
if ! _as_blocks "$BSENV/bin/python3.11" -c "import yaml as _m; assert len(dir(_m)) > 15" >/dev/null 2>&1; then
    echo "[post-merge] PyYAML missing or broken - repairing before the pinned set"
    # --force-reinstall: a gutted package keeps intact dist-info, so a plain install reports it already satisfied.
    _as_blocks "$BSENV/bin/pip" install --quiet --force-reinstall --no-cache-dir \
        "$(grep -im1 '^PyYAML[=><]' "$REQS")" || true
    REINSTALL="--force-reinstall --no-cache-dir"
    rm -f "$SENTINEL" "$ATTEMPT" 2>/dev/null || true
fi
# A zero-length .so is never legitimate: it means the filesystem lost writes mid-flush.
if [ -z "$REINSTALL" ] && [ -n "$(find "$BSENV/lib" -name '*.so' -size 0 -print -quit 2>/dev/null)" ]; then
    echo "[post-merge] truncated extension module - reinstalling venv"
    REINSTALL="--force-reinstall --no-cache-dir"
    rm -f "$SENTINEL" "$ATTEMPT" 2>/dev/null || true
fi
if [ ! -f "$SENTINEL" ] || [ "$(cat "$SENTINEL")" != "$REQS_HASH" ]; then
    echo "[post-merge] requirements changed - pre-installing deps (this may take a few minutes) ..."
    # shellcheck disable=SC2086
    if _as_blocks "$BSENV/bin/pip" install --quiet $REINSTALL \
        --only-binary :all: \
        --no-binary sdbus,sdbus-networkmanager \
        --upgrade-strategy=only-if-needed \
        -r "$REQS"; then
        echo "$REQS_HASH" >"$SENTINEL"
        _own "$SENTINEL"
        rm -f "$ATTEMPT" 2>/dev/null || true
        echo "[post-merge] deps installed"
    else
        # Retry atomic -r failures 3x, then accept the partial venv to stop thrash.
        _prev=$(cut -d' ' -f1 "$ATTEMPT" 2>/dev/null || true)
        _cnt=$(cut -d' ' -f2 "$ATTEMPT" 2>/dev/null || true)
        case "$_cnt" in '' | *[!0-9]*) _cnt=0 ;; esac
        if [ "$_prev" = "$REQS_HASH" ]; then _cnt=$((_cnt + 1)); else _cnt=1; fi
        echo "$REQS_HASH $_cnt" >"$ATTEMPT"
        _own "$ATTEMPT"
        if [ "$_cnt" -ge 3 ]; then
            echo "[post-merge] deps failed ${_cnt}x; giving up to stop thrash (venv left as-is)"
            echo "$REQS_HASH" >"$SENTINEL"
            _own "$SENTINEL"
        fi
    fi
fi

# 2. Sync all service files so start.sh finds them already in place.
bs_sync_service_files "$SCRIPT_PATH" post-merge

# 2b. install.sh runs only at flash time, so re-assert what old images shipped wrong or not at all.
bs_ensure_install_state "$BS_PATH" "$BSENV" post-merge || true
# Install-only: the rename lands at next boot rather than renaming a box that may be printing.
bash "$SCRIPT_PATH/hostname-helper.sh" --install-only || true
# 2c. Fleet-wide USB power fix; old images never wrote this, and it needs a reboot to apply.
bs_ensure_usb_max_current /boot/firmware/config.txt post-merge || true

# 3. Install updater service on first deploy or if missing.
if [ ! -f /etc/systemd/system/BlocksScreen-updater.service ]; then
    echo "[post-merge] installing updater ..."
    sudo bash "$SCRIPT_PATH/install-updater.sh"
fi

# 4. Precompute splash cache so the first Qt restart shows the right logo.
_as_blocks "$BSENV/bin/python3.11" "$SCRIPT_PATH/bs-splash.py" --precompute 2>/dev/null || true


# Under the daemon's own pull a restart here aborts the batch: defer via sentinel.
_record_or() {
    local _reason="$1"; shift
    if [ -n "${BS_UPDATER_SELF_UPDATE:-}" ] && [ -n "${BS_UPDATER_RESTART_SENTINEL:-}" ]; then
        echo "[post-merge] under updater - deferring '${_reason}' to post-batch"
        mkdir -p "$(dirname "$BS_UPDATER_RESTART_SENTINEL")" 2>/dev/null || true
        echo "$_reason" >>"$BS_UPDATER_RESTART_SENTINEL"
    else
        "$@"
    fi
}

if echo "$changed" | grep -qE '^scripts/BlocksScreen-updater\.service$|^scripts/BlocksScreen-bootstrap\.service$|^scripts/com\.blockscreen\.Updater\.conf$|^scripts/install-updater\.sh$|^scripts/bs-apt-helper\.sh$'; then
    echo "[post-merge] Updater install files changed - reinstalling updater ..."
    _record_or install sudo bash "$SCRIPT_PATH/install-updater.sh"
elif echo "$changed" | grep -qE '^scripts/bs-splash-holder\.py$'; then
    # Do NOT restart the holder live: it would re-grab tty8 and steal the display from the running GUI (soft-brick). The new script applies at next boot.
    echo "[post-merge] Splash-holder script changed - applies on next boot (not restarting)."
elif echo "$changed" | grep -qE '^updater/'; then
    echo "[post-merge] Updater code changed - restarting daemon ..."
    _record_or code sudo systemctl restart BlocksScreen-updater.service
fi
