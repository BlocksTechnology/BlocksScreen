[Unit]
Description=BlocksScreen clock fallback (HTTPS Date while NTP is unsynced)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Oneshot has no default start timeout; a hung run would block the timer.
TimeoutStartSec=90
# A rollback below the clock commit removes the script: exit 0 instead of failing each fire.
ExecStart=/bin/bash -c 'cd "$(dirname "$(readlink -f /etc/systemd/system/BlocksScreen-clock.service)")" && [ -f bs-clock-sync.sh ] || exit 0; exec /bin/bash "$(pwd)/bs-clock-sync.sh"'
StandardOutput=journal
StandardError=journal
